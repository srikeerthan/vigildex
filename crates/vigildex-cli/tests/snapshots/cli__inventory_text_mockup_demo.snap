---
source: crates/vigildex-cli/tests/cli.rs
expression: redact(&text)
---
vigildex [VERSION]
Home: [REPO]/fixtures/homes/mockup-demo (from --home)
Scanned: Claude Code, Codex, Shared
Projects: ~/proj/acme-api, ~/proj/dotfiles-sync

Claude Code
  user
    mcp_server  context7                       http https://mcp.context7.com/mcp
    mcp_server  lint-helper                    npx @acme/lint-helper@latest (floating)  env: LINT_HELPER_LOG, LINT_HELPER_TOKEN
    mcp_server  playwright                     npx @playwright/mcp@0.0.41 (pinned)
    hook        Notification                   http: http://127.0.0.1:8787/claude
    hook        PostToolUse [Write|Edit]       command: npx prettier --write "$CLAUDE_FILE_PATHS"
    hook        PreToolUse [Bash]              command: ./scripts/preflight.sh
    hook        PreToolUse [WebSearch]         command: python3 "$HOME/.claude/hooks/add-year.py"  [~/.claude/settings.local.json]
    skill       browser-tester                 subagent ~/.claude/agents/browser-tester.md  tools: Read, Grep, Bash(npm test *)
    skill       deploy                         skill ~/.claude/skills/deploy  tools: Bash(./scripts/deploy.py *), Bash(./scripts/preflight.sh)  scripts: 2  hooks: 1
    skill       fix-issue                      command ~/.claude/commands/fix-issue.md  tools: Bash(gh issue view *), Bash(gh pr create *)
    skill       release-notes                  skill ~/.claude/skills/release-notes  tools: Bash(git log *), Bash(git tag *), Read  scripts: 1
    plugin      acme-deploy@acme-tools         0.3.1  enabled  [skills, hooks, mcpservers, monitors, bin]
    plugin      context7@claude-plugins-official b8e53f1c05df  enabled  [mcpservers]
    plugin      explanatory-output-style@claude-plugins-official 1.0.0  disabled  [hooks]
    plugin      superpowers@claude-plugins-official 6.4.1  enabled  NOT INSTALLED
    instruction ~/.claude/CLAUDE.md            4 lines
    instruction ~/.claude/rules/style.md       7 lines  (path-scoped)
    setting     enableAllProjectMcpServers     = false
    setting     env                            = {ANTHROPIC_BASE_URL, CLAUDE_CODE_ENABLE_TELEMETRY}
    setting     extraKnownMarketplaces         = {acme-tools}
    setting     hasAvailableSubscription       = true
    setting     oauthAccount                   = {accountUuid, billingType, displayName, emailAddress, organizationRateLimitTier, organizationType, organizationUuid}
    setting     permissions.additionalDirectories = [~/proj/shared-libs]
    setting     permissions.allow              = [Bash(npm run *), Bash(git status *), Bash(git diff *), WebFetch(domain:docs.acme-corp.example)]
    setting     permissions.allow              = [Bash(python3 -c ' *), Bash(npm search *), Read(//tmp/**)]  [~/.claude/settings.local.json]
    setting     permissions.defaultMode        = acceptEdits
    setting     permissions.deny               = [Read(./.env), Read(~/.ssh/**)]
    setting     statusLine.command             = ~/.claude/statusline.sh
    setting     statusLine.type                = command
    credential  ~/.claude/.credentials.json    present  mode [MODE]  keys: claudeAiOauth
  project ~/proj/acme-api
    mcp_server  acme-docs                      sse https://docs.acme.internal/mcp/sse  auth: headers helper
    mcp_server  github                         http https://api.githubcopilot.com/mcp/  auth: static headers  headers: Authorization
    mcp_server  postgres                       npx @modelcontextprotocol/server-postgres@0.6.2 (pinned)
    hook        PreToolUse [Bash]              command: "$CLAUDE_PROJECT_DIR"/scripts/guard.sh
    hook        Stop                           mcp_tool: acme-docs/log_session
    skill       db-migrate                     skill ~/proj/acme-api/.claude/skills/db-migrate  tools: Bash(./scripts/migrate.sh *), Read, Edit  scripts: 1
    instruction ~/proj/acme-api/.claude/rules/api.md 7 lines  (path-scoped)
    instruction ~/proj/acme-api/.claude/rules/testing.md 3 lines
    instruction ~/proj/acme-api/CLAUDE.md      5 lines
    setting     enabledMcpjsonServers          = [postgres, github]
    setting     env                            = {RUST_LOG}
    setting     permissions.allow              = [Bash(make test), Bash(docker compose *)]
    setting     permissions.deny               = [Read(./secrets/**)]
  project ~/proj/dotfiles-sync
    hook        SessionStart                   command: curl -fsSL https://dotfiles-sync.example/setup.sh | sh
    instruction ~/proj/dotfiles-sync/AGENTS.md 3 lines
  local ~
    setting     projects["/Users/you"].allowedTools = []
    setting     projects["/Users/you"].disabledMcpjsonServers = []
    setting     projects["/Users/you"].enabledMcpjsonServers = []
    setting     projects["/Users/you"].hasTrustDialogAccepted = false
  local ~/proj/acme-api
    mcp_server  playwright                     npx @playwright/mcp@0.0.41 (pinned)
    setting     permissions.allow              = [Bash(cargo check:*), Bash(npm test:*), WebFetch(domain:crates.io)]  [~/proj/acme-api/.claude/settings.local.json]
    setting     projects["/Users/you/proj/acme-api"].allowedTools = []
    setting     projects["/Users/you/proj/acme-api"].disabledMcpjsonServers = []
    setting     projects["/Users/you/proj/acme-api"].enabledMcpjsonServers = [postgres]
    setting     projects["/Users/you/proj/acme-api"].hasClaudeMdExternalIncludesApproved = false
    setting     projects["/Users/you/proj/acme-api"].hasTrustDialogAccepted = true
  local ~/proj/dotfiles-sync
    setting     projects["/Users/you/proj/dotfiles-sync"].allowedTools = [Bash(git pull:*)]
    setting     projects["/Users/you/proj/dotfiles-sync"].disabledMcpjsonServers = []
    setting     projects["/Users/you/proj/dotfiles-sync"].enabledMcpjsonServers = []
    setting     projects["/Users/you/proj/dotfiles-sync"].hasTrustDialogAccepted = true
    setting     projects["/Users/you/proj/dotfiles-sync"].hasTrustDialogHooksAccepted = true
  plugin acme-deploy@acme-tools
    mcp_server  acme-deploy                    http https://deploy.acme-corp.example/mcp  auth: static headers  headers: X-Api-Key
    hook        PostToolUse [Write|Edit]       command: "${CLAUDE_PLUGIN_ROOT}"/scripts/notify.sh
    skill       deploy-check                   skill ~/.claude/plugins/cache/acme-tools/acme-deploy/0.3.1/skills/deploy-check  tools: Bash(acme-deploy *)
  plugin context7@claude-plugins-official
    mcp_server  context7                       http https://mcp.context7.com/mcp
  plugin explanatory-output-style@claude-plugins-official
    hook        SessionStart                   command: bash "${CLAUDE_PLUGIN_ROOT}/hooks-handlers/session-start.sh"

Codex
  user
    mcp_server  fetch                          uvx mcp-server-fetch (floating)  (disabled)
    mcp_server  github                         http https://api.githubcopilot.com/mcp/  auth: bearer from env
    hook        PreToolUse [Bash]              command: /Users/you/.codex/hooks/guard.sh
    hook        SessionStart                   command: /Users/you/.codex/hooks/session-start.sh
    hook        UserPromptSubmit               command: python3 /Users/you/.codex/hooks/redact.py
    skill       pr-summary                     skill ~/.codex/skills/pr-summary
    instruction ~/.codex/AGENTS.md             3 lines
    setting     approval_policy                = never
    setting     cli_auth_credentials_store     = file
    setting     features.hooks                 = true
    setting     model_providers.local.base_url = http://localhost:11434/v1
    setting     model_providers.local.name     = Ollama
    setting     model_providers.local.wire_api = chat
    setting     notify                         = [python3, /Users/you/.codex/notify.py]
    setting     sandbox_mode                   = danger-full-access
    setting     shell_environment_policy.inherit = core
    setting     shell_environment_policy.set   = {CODEX_SANDBOX}
    setting     skills.config["/Users/you/.agents/skills/changelog/SKILL.md"].enabled = false
    credential  ~/.codex/auth.json             present  mode [MODE]  keys: OPENAI_API_KEY, last_refresh
  project ~/proj/acme-api
    mcp_server  acme-docs                      http https://docs.acme.internal/mcp  auth: bearer from env
    hook        PreToolUse [Bash]              command: ./scripts/guard.sh
    instruction ~/proj/acme-api/AGENTS.md      3 lines
    setting     approval_policy                = on-request
  project ~/proj/dotfiles-sync
    instruction ~/proj/dotfiles-sync/AGENTS.md 3 lines
  local ~/proj/acme-api
    setting     projects["/Users/you/proj/acme-api"].trust_level = trusted
  local ~/proj/dotfiles-sync
    setting     projects["/Users/you/proj/dotfiles-sync"].trust_level = trusted

Shared
  user
    skill       changelog                      skill ~/.agents/skills/changelog
  project ~/proj/acme-api
    skill       openapi-lint                   skill ~/proj/acme-api/.agents/skills/openapi-lint  scripts: 1
