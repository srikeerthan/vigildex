  {
    "id": "8bf5fa10c6a8063b",
    "rule": "RISK-004",
    "category": "risk",
    "severity": "medium",
    "title": "Auto-approves every tool",
    "why": "Every tool call runs without approval, so one bad instruction can act on your files and accounts.",
    "location": {
      "path": "[HOME]/.codex/config.toml",
      "line": 3,
      "key_path": "approval_policy"
    },
    "evidence": "approval_policy = \"never\", sandbox_mode = \"danger-full-access\"",
    "fingerprint": null,
    "fix": {
      "summary": "Turn approvals back on",
      "steps": [
        "Claude Code: set `permissions.defaultMode` back to `default` or `acceptEdits`.",
        "Codex: use `approval_policy = \"on-request\"` or keep `sandbox_mode` at `workspace-write`."
      ]
    },
    "agents": [
      "codex"
    ],
    "items": [
      "745dfc46cd77e76f",
      "b62fb0570291c733"
