[
  {
    "id": "a854cbc7b6c5c6f6",
    "rule": "BILL-001",
    "category": "billing",
    "severity": "high",
    "title": "API key bills headless runs",
    "why": "Claude Code uses `ANTHROPIC_API_KEY` for every `claude -p` run even though a subscription is signed in, so those runs are billed to the key.",
    "location": {
      "path": "[HOME]/.zshrc",
      "line": 42,
      "key_path": "ANTHROPIC_API_KEY"
    },
    "evidence": "ANTHROPIC_API_KEY=sk-ant-••••7Qa",
    "fingerprint": null,
    "fix": {
      "summary": "Remove the key from your environment and let the subscription login bill",
      "steps": [
        "Delete the export from the profile (or scope it to the one script that needs it).",
        "Start a new shell and check `env | grep ANTHROPIC` shows nothing."
      ]
    },
    "agents": [
      "claude_code"
    ],
    "items": [
      "3c6cd19254ea05dc"
    ],
    "tags": [
      "SEC-004"
    ]
  },
  {
    "id": "0854c66a81d7d0e9",
    "rule": "BILL-006",
    "category": "billing",
    "severity": "medium",
    "title": "Custom API gateway",
    "why": "Requests, and the API key with them, go to this host instead of the vendor.",
    "location": {
      "path": "[HOME]/.claude/settings.json",
      "line": null,
      "key_path": "env.ANTHROPIC_BASE_URL"
    },
    "evidence": "ANTHROPIC_BASE_URL=https://llm-proxy.acme-corp.example",
    "fingerprint": null,
    "fix": {
      "summary": "Point the base URL back at the vendor unless you trust this gateway",
      "steps": [
        "Check who runs the host and why the base URL was set.",
        "Remove the override, or keep it only for the shell or project that needs it.",
        "If a repository set it, rotate the API key that was used while it applied."
      ]
    },
    "agents": [
      "claude_code"
    ],
    "items": [
      "de21aff9b683f172"
    ],
    "tags": []
  },
