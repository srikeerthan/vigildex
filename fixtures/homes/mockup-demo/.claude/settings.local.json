{
  "permissions": {
    "allow": [
      "Bash(python3 -c ' *)",
      "Bash(npm search *)",
      "Read(//tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/add-year.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
